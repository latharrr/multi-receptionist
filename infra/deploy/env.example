# Copy to .env (git-ignored) and fill in. Never commit real values or paste them into a chat.
# Generate secrets with:  openssl rand -base64 32     Passwords: letters and digits only keep the URLs simple.

# --- compose itself
APP_DOMAIN=app.example.com
APP_VERSION=local
POSTGRES_PASSWORD=

# --- every process
APP_ENV=production
DATA_DIR=/data
# Opens tenants' saved keys. Keep a copy OUTSIDE the backups: without it they cannot be read again.
MASTER_KEY=
AUTH_SECRET=
PUBLIC_URL=https://app.example.com
SUPPORT_EMAIL=
OPERATOR_EMAILS=

# One login per process. `migrate` sets each role's password to the one written here.
DATABASE_URL_MIGRATE=postgres://postgres:POSTGRES_PASSWORD@db:5432/receptionist
DATABASE_URL_WEB=postgres://app_user:CHANGE1@db:5432/receptionist
DATABASE_URL_WORKER=postgres://app_worker:CHANGE2@db:5432/receptionist
DATABASE_URL_CALLBACK=postgres://app_callback:CHANGE3@db:5432/receptionist
DATABASE_URL_AUTH=postgres://app_auth:CHANGE4@db:5432/receptionist
DATABASE_URL_OPERATOR=postgres://app_operator:CHANGE5@db:5432/receptionist

# --- email (sign-in links, invitations, staff alerts)
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM=Receptionist <no-reply@example.com>

# --- official WhatsApp route (leave both empty to keep it switched off)
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- unofficial QR route (off unless set to on, and the gateway profile is started)
QR_GATEWAY=off
